{
  "name": "voice-scheduling-agent-backend",
  "version": "1.0.0",
  "description": "Backend API for Voice Scheduling Agent - Creates calendar events via voice conversation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "auth": "node get-refresh-token.js",
    "test": "node test-api.js",
    "test:local": "API_URL=http://localhost:3000 node test-api.js",
    "test:production": "node test-api.js",
    "logs": "tail -f logs/*.log",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [
    "voice-assistant",
    "scheduling",
    "calendar",
    "vapi",
    "google-calendar",
    "ai-agent"
  ],
  "author": "Pathan",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "googleapis": "^128.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "open": "^10.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/voice-scheduling-agent.git"
  }
}
